{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "juggle-editor-demo",
  "compatibility_date": "2026-11-04",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./build",
    "not_found_handling": "single-page-application"
  }
}
